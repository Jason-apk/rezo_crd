{
  "expo": {
    "name": "rezo_crd",
    "slug": "rezo-crd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images-rezo/icon.png",
    "scheme": "rezocrd",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images-rezo/adaptive-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images-rezo/monochrome-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.africadatalab.rezocrd",

      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images-rezo/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "REZO partage votre position pendant le trajet pour calculer les temps d'attente."
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images-rezo/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d1a69856-40cd-4bd1-b932-de008c95242b"
      }
    },
    "owner": "hopetg"
  }
}
